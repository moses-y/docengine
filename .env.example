# Copy to .env and adjust as needed. Never commit the real .env.

# --- Postgres ---
POSTGRES_USER=docengine
POSTGRES_PASSWORD=docengine
POSTGRES_DB=docengine
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Backend ---
DATABASE_URL=postgresql+asyncpg://docengine:docengine@postgres:5432/docengine
JWT_SECRET=change-me-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MAX_UPLOAD_BYTES=5242880
STORAGE_DIR=/data/storage
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Frontend (build-time) ---
VITE_API_BASE_URL=/api
